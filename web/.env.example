# PromisePulse Gemini Research Assistant — LOCAL DEVELOPMENT ONLY
#
# Copy this file to web/.env (do not edit this tracked example):
#   cd web && cp .env.example .env
#
# Paste your Gemini API key ONLY in the untracked web/.env.
# Do not prepend VITE_: Vite exposes VITE_* values to browser bundles.
GEMINI_API_KEY=

# Optional: server-side Gemini model. Check its availability for your key.
GEMINI_MODEL=gemini-2.5-flash
